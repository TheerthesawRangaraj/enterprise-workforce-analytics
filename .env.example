# ==============================================================================
# SkillMatrix AI - Environment Configuration Template
# Copy this file to .env or .env.local for local overrides
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Application Title
VITE_APP_TITLE=SkillMatrix AI - Employee Skill Mapping & Risk Analysis Platform

# Backend REST API Base URL
# Leave empty or set to /api if deploying frontend and backend together
# For standalone local development: http://localhost:5000/api
# For production cloud deployment: https://api.yourdomain.com/api or /api
VITE_API_BASE_URL=

# Fallback to in-memory/localStorage data when backend API is unreachable
VITE_ENABLE_MOCK_FALLBACK=true

# Demo User Auto-Login on first visit (true | false)
VITE_DEMO_MODE=true

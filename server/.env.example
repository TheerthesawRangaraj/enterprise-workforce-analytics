# ==============================================================================
# SkillMatrix AI Backend - Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5000

# Server Node Environment (development | production | test)
NODE_ENV=production

# CORS Allowed Origins (Comma-separated URLs or wildcard *)
# e.g., https://skillmatrix.vercel.app,https://yourdomain.com
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Optional - in-memory fallback enabled if omitted)
# Format: postgresql://username:password@host:5432/database_name?sslmode=require
DATABASE_URL=

# Optional Redis Connection URL (for distributed rate limiting / caching)
# Format: redis://username:password@host:6379
REDIS_URL=
